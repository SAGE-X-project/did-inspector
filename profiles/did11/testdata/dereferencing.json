          "check": "success",
          "statements": [
            "res10-crd20261001#dereferencing.1",
            "res10-crd20261001#dereferencing.5",
            "res10-crd20261001#dereferencing.8",
            "res10-crd20261001#dereferencing-algorithm-resource.5",
