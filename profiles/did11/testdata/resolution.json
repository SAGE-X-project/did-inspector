      "function": "resolve",
      "input": "did:example:123456789abcdefghi",
      "options": {},
      "expect": [
        {
          "check": "success",
          "statements": [
            "res10-crd20261001#resolving.1",
            "res10-crd20261001#resolving.3",
            "res10-crd20261001#did-resolution-options.4",
            "res10-crd20261001#resolving-algorithm.17",
            "res10-crd20261001#resolving-algorithm.32"
          ]
        },
        {
          "check": "noError",
          "statements": [
            "res10-crd20261001#resolving-algorithm.33"
          ]
        },
        {
          "check": "documentId",
          "value": "did:example:123456789abcdefghi",
          "statements": [
            "res10-crd20261001#resolving.7",
            "res10-crd20261001#resolving-algorithm.34"
          ]
        },
        {
          "check": "documentEquals",
          "value": {
            "@context": [
              "https://www.w3.org/ns/did/v1.1",
              "https://didcomm.org/messaging/contexts/v2",
              "https://identity.foundation/linked-vp/contexts/v1"
            ],
            "id": "did:example:123456789abcdefghi",
            "verificationMethod": [
              {
                "id": "did:example:123456789abcdefghi#keys-1",
                "type": "Multikey",
                "controller": "did:example:123456789abcdefghi",
                "publicKeyMultibase": "z6MkmM42vxfqZQsv4ehtTjFFxQ4sQKS2w6WR7emozFAn5cxu"
              }
            ],
            "service": [
              {
                "id": "did:example:123456789abcdefghi#messages",
                "type": "DIDCommMessaging",
                "serviceEndpoint": "https://example.com/messages/8377464"
              },
              {
                "id": "did:example:123456789abcdefghi#linkedvp",
                "type": "LinkedVerifiablePresentation",
                "serviceEndpoint": "https://example.com/verifiable-presentation.jsonld"
              }
            ]
          },
          "statements": [
            "res10-crd20261001#resolving.6",
            "res10-crd20261001#resolving-algorithm.26"
          ],
          "partial": "the document is compared with the stored conformant representation; other representations are not judged"
        },
        {
          "check": "contentMetadataHas",
          "value": {
            "created": "2019-03-23T06:35:22Z",
            "updated": "2023-08-10T13:40:06Z",
            "versionId": "1"
          },
          "statements": [
            "res10-crd20261001#resolving.9"
          ]
        },
        {
          "check": "contentTypeAnywhere",
          "value": "application/did",
          "statements": [
            "res10-crd20261001#resolving-algorithm.35"
          ],
          "partial": "the media type is accepted in either metadata structure: §4.4 puts contentType in didDocumentMetadata, §4.2 in didResolutionMetadata"
        }
      ]
    },
