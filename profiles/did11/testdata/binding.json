{
  "exchanges": [
    {
      "case": "resolve-get",
      "note": "GET request for the complete DID resolution result (DID Resolution §12.1, Examples 24, 30, 31).",
      "function": "resolve",
      "input": "did:example:123456789abcdefghi",
      "expect": [
        {
          "check": "status",
          "value": 200,
          "statements": [
            "res10-crd20261001#bindings-https.1",
            "res10-crd20261001#bindings-https.4",
            "res10-crd20261001#bindings-https.5",
            "res10-crd20261001#bindings-https.6",
            "res10-crd20261001#bindings-https.17"
          ],
          "partial": "the GET version is judged; implementing the POST version is a permission. judged from the resolver side: a request built by this step is answered with the result of the function; the client's part of the step is not judged"
        },
        {
          "check": "status",
          "value": 200,
          "statements": [
            "res10-crd20261001#bindings-https.28",
            "res10-crd20261001#bindings-https.29"
