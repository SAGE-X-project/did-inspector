    {
      "case": "dereference-fragment",
      "note": "GET request for the complete result of a DID URL with a fragment. A fragment cannot travel in a request target, so the DID URL is sent percent-encoded (DID Resolution §12.1, RFC 3986 §2.1).",
      "function": "dereference",
      "input": "did:example:relationships#key-1",
      "expect": [
        {
          "check": "status",
          "value": 200,
          "statements": [
            "res10-crd20261001#bindings-https.39",
            "res10-crd20261001#bindings-https.40"
