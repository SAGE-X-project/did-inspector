          "statements": [
            "res10-crd20261001#bindings-https.15",
            "res10-crd20261001#bindings-https.16"
          ],
          "partial": "the URL-encoding is the client's duty; judged from the resolver side: the URL-encoded DID is decoded and the query parameter is applied"
