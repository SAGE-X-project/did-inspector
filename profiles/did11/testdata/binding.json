  "probes": [
    {
      "note": "INVALID_DID",
      "function": "resolve",
      "input": "did:Example:123"
    },
    {
      "note": "NOT_FOUND",
      "function": "resolve",
      "input": "did:example:doesnotexist"
    },
    {
      "note": "METHOD_NOT_SUPPORTED",
      "function": "resolve",
      "input": "did:inspectorunsupported:123"
    },
    {
      "note": "INVALID_OPTIONS",
      "function": "resolve",
      "input": "did:example:versioned",
      "options": {
        "versionTime": "2021-05-10 17:00:00"
      }
    },
    {
      "note": "INVALID_DID_DOCUMENT",
      "function": "resolve",
      "input": "did:example:malformed"
    },
    {
      "note": "INTERNAL_ERROR",
      "function": "resolve",
      "input": "did:example:failing"
    },
    {
      "note": "FEATURE_NOT_SUPPORTED or an extension option",
      "function": "resolve",
      "input": "did:example:123456789abcdefghi",
      "options": {
        "inspectorUnsupportedOption": "value"
      }
    },
    {
      "note": "noCache",
      "function": "resolve",
      "input": "did:example:123456789abcdefghi",
      "options": {
        "noCache": true
      }
    },
    {
      "note": "INVALID_DID_URL",
      "function": "dereference",
      "input": "did:example:123456789abcdefghi#a#b"
    },
    {
      "note": "REPRESENTATION_NOT_SUPPORTED",
      "function": "dereference",
      "input": "did:example:services?service=files",
      "accept": "image/png"
    },
    {
      "note": "NOT_FOUND as problem details",
      "function": "dereference",
      "input": "did:example:doesnotexist",
      "accept": "application/did"
    },
    {
      "note": "INVALID_DID as problem details",
      "function": "resolve",
      "input": "did:Example:123",
      "accept": "application/did"
    },
    {
      "note": "deactivated, dereferenced",
      "function": "dereference",
      "input": "did:example:deactivated"
    }
  ]
