{
  "scenarios": [
    {
      "case": "resolve-found",
      "note": "resolve returns the DID document in its abstract form (DID Core 1.0 §7.1).",
      "function": "resolve10",
      "input": "did:example:123456789abcdefghi",
      "options": {},
      "expect": [
        {
          "check": "success",
          "statements": [
            "core10#did-resolution.2",
            "core10#did-resolution.6"
          ]
        },
        {
          "check": "noError",
          "statements": [
            "core10#did-resolution.6"
          ]
        },
        {
          "check": "documentId",
          "value": "did:example:123456789abcdefghi",
          "statements": [
            "core10#did-resolution.7"
          ]
        },
        {
          "check": "documentEquals",
          "value": {
            "@context": "https://www.w3.org/ns/did/v1",
            "id": "did:example:123456789abcdefghi",
            "verificationMethod": [
              {
                "id": "did:example:123456789abcdefghi#key-1",
                "type": "JsonWebKey2020",
                "controller": "did:example:123456789abcdefghi",
                "publicKeyJwk": {
                  "kty": "OKP",
                  "crv": "Ed25519",
                  "x": "VCpo2LMLhn6iWku8MKvSLg2ZAoC-nlOyPVQaO3FxVeQ"
                }
              }
            ],
            "authentication": [
              "did:example:123456789abcdefghi#key-1"
            ],
            "service": [
              {
                "id": "did:example:123456789abcdefghi#vcs",
                "type": "VerifiableCredentialService",
                "serviceEndpoint": "https://example.com/vc/"
              }
            ]
          },
          "statements": [
            "core10#did-resolution.6"
          ],
          "partial": "the abstract document is compared with the stored representation, ignoring @context"
        },
        {
          "check": "contentMetadataHas",
          "value": {
            "created": "2019-03-23T06:35:22Z",
            "updated": "2023-08-10T13:40:06Z",
            "versionId": "1"
          },
          "statements": [
            "core10#did-resolution.11"
          ]
        },
        {
          "check": "contentTypeAbsent",
          "statements": [
            "core10#did-resolution-metadata.2"
          ]
        }
      ]
    },
